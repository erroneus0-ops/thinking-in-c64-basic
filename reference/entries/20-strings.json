{
 "family": "Strings",
 "intro": "Functions that measure, extract, convert and build strings. Positions within a string are numbered from 1. Numeric arguments are truncated to whole numbers before use (2.9 is used as 2).",
 "setup": [
  "N$ = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\""
 ],
 "entries": [
  {
   "keyword": "LEN",
   "syntax": "LEN(string)",
   "returns": "number",
   "arguments": [
    [
     "string",
     "string expression",
     "The string to measure."
    ]
   ],
   "description": "Returns the number of characters in the string, from 0 (empty string) to 255. Spaces and control characters count.",
   "example": {
    "vars": [
     [
      "N$",
      "sample source string (26 letters)"
     ],
     [
      "L",
      "receives the length"
     ]
    ],
    "code": [
     "N$ = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
     "L = LEN(N$)",
     "PRINT L"
    ],
    "output": [
     " 26"
    ]
   },
   "cases": [
    [
     "LEN(N$)",
     "26",
     ""
    ],
    [
     "LEN(\"\")",
     "0",
     "The empty string."
    ],
    [
     "LEN(STR$(42))",
     "3",
     "STR$ includes a leading space for positive numbers."
    ]
   ],
   "errors": [],
   "related": [
    "LEFT$",
    "RIGHT$",
    "MID$",
    "STR$"
   ]
  },
  {
   "keyword": "LEFT$",
   "syntax": "LEFT$(string, count)",
   "returns": "string",
   "arguments": [
    [
     "string",
     "string expression",
     "The source string."
    ],
    [
     "count",
     "numeric expression, 0–255",
     "Number of characters to take from the left end."
    ]
   ],
   "description": "Returns the leftmost count characters of the string. If count is greater than the string's length, the whole string is returned.",
   "example": {
    "vars": [
     [
      "N$",
      "sample source string (26 letters)"
     ],
     [
      "A$",
      "receives the result"
     ]
    ],
    "code": [
     "N$ = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
     "A$ = LEFT$(N$,3)",
     "PRINT A$"
    ],
    "output": [
     "ABC"
    ]
   },
   "cases": [
    [
     "LEFT$(N$,3)",
     "\"ABC\"",
     ""
    ],
    [
     "LEFT$(N$,0)",
     "\"\"",
     "Empty string."
    ],
    [
     "LEFT$(N$,30)",
     "\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
     "More than the length: the whole string, no error."
    ],
    [
     "LEFT$(N$,2.9)",
     "\"AB\"",
     "Count is truncated."
    ],
    [
     "LEFT$(N$,-1)",
     "?ILLEGAL QUANTITY  ERROR",
     ""
    ],
    [
     "LEFT$(N$,256)",
     "?ILLEGAL QUANTITY  ERROR",
     ""
    ]
   ],
   "errors": [
    "?ILLEGAL QUANTITY  ERROR: count less than 0 or greater than 255."
   ],
   "related": [
    "RIGHT$",
    "MID$",
    "LEN"
   ]
  },
  {
   "keyword": "RIGHT$",
   "syntax": "RIGHT$(string, count)",
   "returns": "string",
   "arguments": [
    [
     "string",
     "string expression",
     "The source string."
    ],
    [
     "count",
     "numeric expression, 0–255",
     "Number of characters to take from the right end."
    ]
   ],
   "description": "Returns the rightmost count characters of the string. If count is greater than the string's length, the whole string is returned.",
   "example": {
    "vars": [
     [
      "N$",
      "sample source string (26 letters)"
     ],
     [
      "A$",
      "receives the result"
     ]
    ],
    "code": [
     "N$ = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
     "A$ = RIGHT$(N$,3)",
     "PRINT A$"
    ],
    "output": [
     "XYZ"
    ]
   },
   "cases": [
    [
     "RIGHT$(N$,3)",
     "\"XYZ\"",
     ""
    ],
    [
     "RIGHT$(N$,0)",
     "\"\"",
     "Empty string."
    ],
    [
     "RIGHT$(N$,30)",
     "\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
     "More than the length: the whole string, no error."
    ],
    [
     "RIGHT$(\"\",3)",
     "\"\"",
     "From an empty string: empty string."
    ]
   ],
   "errors": [
    "?ILLEGAL QUANTITY  ERROR: count less than 0 or greater than 255."
   ],
   "related": [
    "LEFT$",
    "MID$",
    "LEN"
   ]
  },
  {
   "keyword": "MID$",
   "syntax": "MID$(string, start[, length])",
   "returns": "string",
   "arguments": [
    [
     "string",
     "string expression",
     "The source string."
    ],
    [
     "start",
     "numeric expression, 1–255",
     "Position of the first character to take; the first character is position 1."
    ],
    [
     "length",
     "numeric expression, 0–255 (optional)",
     "Number of characters to take. If omitted, all characters from start to the end."
    ]
   ],
   "description": "Returns length characters of the string, beginning at position start. If fewer characters remain than requested, returns those that remain; if start is beyond the end, returns an empty string. Can replace LEFT$ (start 1) and RIGHT$, though those state the intent more directly.",
   "example": {
    "vars": [
     [
      "N$",
      "sample source string (26 letters)"
     ],
     [
      "A$",
      "receives the result"
     ]
    ],
    "code": [
     "N$ = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
     "A$ = MID$(N$,3,4)",
     "PRINT A$"
    ],
    "output": [
     "CDEF"
    ]
   },
   "cases": [
    [
     "MID$(N$,3,4)",
     "\"CDEF\"",
     ""
    ],
    [
     "MID$(N$,24)",
     "\"XYZ\"",
     "Length omitted: to the end."
    ],
    [
     "MID$(N$,25,10)",
     "\"YZ\"",
     "Fewer remain than requested: those that remain."
    ],
    [
     "MID$(N$,27)",
     "\"\"",
     "Start beyond the end: empty string, no error."
    ],
    [
     "MID$(N$,3,0)",
     "\"\"",
     "Length 0: empty string."
    ],
    [
     "MID$(N$,2.9,2)",
     "\"BC\"",
     "Start is truncated to 2."
    ],
    [
     "MID$(N$,0,1)",
     "?ILLEGAL QUANTITY  ERROR",
     "Positions start at 1."
    ],
    [
     "MID$(N$,256)",
     "?ILLEGAL QUANTITY  ERROR",
     ""
    ],
    [
     "MID$(N$,3,256)",
     "?ILLEGAL QUANTITY  ERROR",
     ""
    ]
   ],
   "errors": [
    "?ILLEGAL QUANTITY  ERROR: start less than 1 or greater than 255, or length less than 0 or greater than 255."
   ],
   "related": [
    "LEFT$",
    "RIGHT$",
    "LEN"
   ]
  },
  {
   "keyword": "STR$",
   "syntax": "STR$(number)",
   "returns": "string",
   "arguments": [
    [
     "number",
     "numeric expression",
     "The value to convert."
    ]
   ],
   "description": "Returns the number as a string, formatted exactly as PRINT would display it, including the leading space that PRINT reserves for the sign of a positive number (or the minus sign of a negative one). No trailing space is added.",
   "example": {
    "vars": [
     [
      "S",
      "a numeric value"
     ],
     [
      "A$",
      "receives the result"
     ]
    ],
    "code": [
     "S = 42",
     "A$ = \"SCORE:\" + STR$(S)",
     "PRINT A$"
    ],
    "output": [
     "SCORE: 42"
    ]
   },
   "cases": [
    [
     "STR$(5)",
     "\" 5\"",
     "Leading space for a positive number."
    ],
    [
     "STR$(-5)",
     "\"-5\"",
     "The minus sign takes that position."
    ],
    [
     "STR$(0)",
     "\" 0\"",
     ""
    ],
    [
     "STR$(.5)",
     "\" .5\"",
     "No leading zero before the decimal point."
    ],
    [
     "STR$(1/3)",
     "\" .333333333\"",
     "Nine significant digits."
    ],
    [
     "STR$(1E10)",
     "\" 1E+10\"",
     "Large values in exponent form."
    ]
   ],
   "errors": [],
   "related": [
    "VAL",
    "LEN"
   ]
  },
  {
   "keyword": "VAL",
   "syntax": "VAL(string)",
   "returns": "number",
   "arguments": [
    [
     "string",
     "string expression",
     "Text to read as a number."
    ]
   ],
   "description": "Returns the numeric value of the leading part of the string. Leading spaces are skipped; reading stops at the first character that cannot continue a number. A string with no leading number gives 0, without an error. Exponent notation (1E3) is accepted.",
   "example": {
    "vars": [
     [
      "A$",
      "text containing digits"
     ],
     [
      "V",
      "receives the value"
     ]
    ],
    "code": [
     "A$ = \"123\"",
     "V = VAL(A$) + 1",
     "PRINT V"
    ],
    "output": [
     " 124"
    ]
   },
   "cases": [
    [
     "VAL(\"12ABC\")",
     "12",
     "Stops at the first non-numeric character."
    ],
    [
     "VAL(\" 12\")",
     "12",
     "Leading spaces are skipped."
    ],
    [
     "VAL(\"-3.5\")",
     "-3.5",
     ""
    ],
    [
     "VAL(\"+5\")",
     "5",
     ""
    ],
    [
     "VAL(\"1E3\")",
     "1000",
     "Exponent notation."
    ],
    [
     "VAL(\"1,000\")",
     "1",
     "A comma ends the number."
    ],
    [
     "VAL(\"ABC\")",
     "0",
     "No leading number: 0, no error."
    ],
    [
     "VAL(\"\")",
     "0",
     ""
    ]
   ],
   "errors": [],
   "related": [
    "STR$",
    "ASC"
   ]
  },
  {
   "keyword": "CHR$",
   "syntax": "CHR$(code)",
   "returns": "string",
   "arguments": [
    [
     "code",
     "numeric expression, 0–255",
     "A PETSCII character code."
    ]
   ],
   "description": "Returns a one-character string containing the character with the given PETSCII code. Codes include printable characters and control codes; for example, CHR$(147) clears the screen when printed, and CHR$(13) is RETURN.",
   "example": {
    "vars": [
     [
      "A$",
      "receives the character"
     ]
    ],
    "code": [
     "A$ = CHR$(65)",
     "PRINT A$"
    ],
    "output": [
     "A"
    ]
   },
   "cases": [
    [
     "CHR$(65)",
     "\"A\"",
     ""
    ],
    [
     "CHR$(65.9)",
     "\"A\"",
     "Code is truncated."
    ],
    [
     "ASC(CHR$(13))",
     "13",
     "CHR$ and ASC are inverses."
    ],
    [
     "CHR$(256)",
     "?ILLEGAL QUANTITY  ERROR",
     ""
    ],
    [
     "CHR$(-1)",
     "?ILLEGAL QUANTITY  ERROR",
     ""
    ]
   ],
   "errors": [
    "?ILLEGAL QUANTITY  ERROR: code less than 0 or greater than 255."
   ],
   "related": [
    "ASC"
   ]
  },
  {
   "keyword": "ASC",
   "syntax": "ASC(string)",
   "returns": "number",
   "arguments": [
    [
     "string",
     "string expression, at least one character",
     "Only the first character is used."
    ]
   ],
   "description": "Returns the PETSCII code (0–255) of the first character of the string.",
   "example": {
    "vars": [
     [
      "A$",
      "a one-character string"
     ],
     [
      "C",
      "receives the code"
     ]
    ],
    "code": [
     "A$ = \"A\"",
     "C = ASC(A$)",
     "PRINT C"
    ],
    "output": [
     " 65"
    ]
   },
   "cases": [
    [
     "ASC(\"A\")",
     "65",
     ""
    ],
    [
     "ASC(\"ABC\")",
     "65",
     "Only the first character counts."
    ],
    [
     "ASC(\" \")",
     "32",
     "Space."
    ],
    [
     "ASC(\"\")",
     "?ILLEGAL QUANTITY  ERROR",
     "The empty string has no first character."
    ]
   ],
   "errors": [
    "?ILLEGAL QUANTITY  ERROR: the string is empty."
   ],
   "related": [
    "CHR$",
    "VAL"
   ]
  }
 ]
}